# Which LLM powers synopsis + analyst brief generation: "anthropic" or "gemini"
LLM_PROVIDER=gemini

# Cloud mode (Vercel sets these to true/false as shown). Local development
# should keep HOSTED_MODE and HOSTED_READ_ONLY false.
HOSTED_MODE=false
HOSTED_READ_ONLY=false
SCHEDULER_ENABLED=true
ALLOWED_ORIGINS=
DATABASE_URL=sqlite:///./sentinel.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=audio-briefs

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# Only needed if LLM_PROVIDER=gemini — get a free key at aistudio.google.com
GEMINI_API_KEY=
# "gemini-flash-latest" is Google's official alias that always points to
# whichever stable Flash model is current — use this rather than a dated
# model name (e.g. gemini-2.5-flash), since Google periodically retires
# dated versions for new API keys/projects even before the official
# deprecation date, which breaks a hardcoded name with a 404.
GEMINI_MODEL=gemini-flash-latest
# Free-tier Gemini keys can have very low daily request caps (sometimes just
# 20/day) — check yours at aistudio.google.com under "Rate Limits". If you're
# hitting 429 errors, set this to false to skip the fact-check second pass
# (saves 1 call per brief generation), and/or raise the interval minutes below.
ENABLE_FACT_CHECK=true

# Optional: enables X/Twitter recent-search ingestion (needs a paid API tier)
TWITTER_BEARER_TOKEN=

# Scheduling — tune these to your API key's daily request limit.
# gemini-flash-latest (resolves to gemini-3.6-flash as of Aug 2026) has a
# much higher free-tier RPD than the deprecated 2.5-flash. At 60min/120min
# defaults the app makes ~60-72 LLM calls/day. If you hit 429s, raise these.
INGEST_INTERVAL_MINUTES=15
SYNOPSIS_INTERVAL_MINUTES=60
BRIEF_INTERVAL_MINUTES=120

# Daily local audio briefing. Generation begins at 06:45 Europe/London so the
# episode is normally ready by 07:00. Speech is produced locally at no charge.
AUDIO_BRIEF_ENABLED=true
AUDIO_BRIEF_TIMEZONE=Europe/London
AUDIO_BRIEF_HOUR=6
AUDIO_BRIEF_MINUTE=45
AUDIO_BRIEF_RETENTION_DAYS=30
AUDIO_BRIEF_VOICE=bm_george
AUDIO_BRIEF_FALLBACK_VOICE=Daniel
AUDIO_BRIEF_SPEED=1.08
AUDIO_BRIEF_FALLBACK_RATE=175
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
ARTICLE_RETENTION_DAYS=45
LOG_LEVEL=INFO

# Optional: email alerts for severity>=4 SIGACTs. Leave ALERT_SMTP_HOST blank
# to disable entirely. For Gmail: host smtp.gmail.com, port 587, and use an
# "app password" (not your normal password) for ALERT_SMTP_PASS.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
